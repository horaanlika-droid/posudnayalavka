# ────────────────────────────────────────────────────────────────
#  «Посудная лавка» — переменные окружения
#  Все значения задаются в панели хостинга (BotHost) — в коде их нет.
#  Ничего секретного в репозиторий не коммитим.
# ────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# Публичный HTTPS-адрес приложения (без слэша на конце).
# Нужен для кнопки Mini App, ссылок на счета и вебхуков.
PUBLIC_URL=
# Имя бота без @ (для ссылок вида t.me/<bot>?startapp=...)
BOT_USERNAME=
# Режим получения апдейтов: polling (по умолчанию) или webhook
TELEGRAM_MODE=polling
# Секрет вебхука (если TELEGRAM_MODE=webhook) — произвольная строка
TELEGRAM_WEBHOOK_SECRET=

# ── Сервер ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Что запускать: all | web | bot
MODE=all
# Разрешить вход без Telegram (локальная разработка / превью в браузере).
# На проде оставить пустым или 0.
ALLOW_DEV_AUTH=

# ── ЮKassa ───────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС для чека 54-ФЗ: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%
YOOKASSA_VAT_CODE=1
# Отправлять чек в ЮKassa (1/0)
YOOKASSA_RECEIPT=1

# ── Реквизиты продавца (для счёта юрлицам) ───────────────────────
SELLER_NAME=
SELLER_LEGAL_NAME=
SELLER_INN=
SELLER_KPP=
SELLER_OGRN=
SELLER_ADDRESS=
SELLER_BANK_NAME=
SELLER_BANK_BIK=
SELLER_BANK_ACCOUNT=
SELLER_CORR_ACCOUNT=
SELLER_SIGNER=
SELLER_PHONE=
SELLER_EMAIL=
# Префикс номера счёта
INVOICE_PREFIX=ПЛ-
# НДС в счёте: none | 20 | 10
INVOICE_VAT=none

# ── Магазин ──────────────────────────────────────────────────────
# Бесплатная доставка от суммы (₽)
FREE_SHIPPING_FROM=30000
# Стоимость доставки по России, если сумма меньше (₽)
SHIPPING_COST=790
# Минимальная сумма заказа (₽)
MIN_ORDER_TOTAL=0
