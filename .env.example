# ============================================================
#  POSUDNAYA LAVKA — environment configuration
#  Copy to `.env` and fill in your own values on the host.
#  NEVER commit real keys.
# ============================================================

# --- Core ---
# Public base URL of the web app (used for redirects / webhook).
# On local dev keep http://localhost:3000
PUBLIC_URL=http://localhost:3000
PORT=3000

# --- Catalog images use remote URLs; if you self-host under public/img, set this.
# NEXTAUTH ... not used.

# --- Telegram bot ---
# Token from @BotFather.
BOT_TOKEN=
# Telegram user id of the admin who answers support / receives orders (int).
ADMIN_ID=

# Bot transport: "polling" (recommended on a VPS) or "webhook".
BOT_MODE=polling
# Only when BOT_MODE=webhook (public URL + a secret you choose):
BOT_WEBHOOK_SECRET=

# --- Payments ---
# Currency (three-letter). Prices in catalog are stored in minor units of this currency.
CURRENCY=RUB

# 1) GRM (Gram) wallet. Insert the credentials given to you on the host.
#    Endpoint shape depends on the wallet provider you use — adapt src/lib/payments/gram.ts.
GRM_API_BASE=
GRM_API_KEY=
# Merchant / wallet account that receives funds:
GRM_RECEIVER=

# 2) YooKassa. Insert your shop data on the host.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# When keys are empty the app runs in SIMULATION mode (payments succeed in test)
# so you can try the full flow before plugging real credentials.

# --- Legal entity (счёт / Юр. лицо) ---
# Bank / requisites printed on the invoice document the admin issues for legal entities.
ORG_NAME=
ORG_INN=
ORG_KPP=
ORG_BIK=
ORG_ACCOUNT=
ORG_CORR_ACCOUNT=
ORG_BANK=
ORG_ADDRESS=
ORG_PHONE=
ORG_EMAIL=
ORG_CEO=          # ФИО руководителя, основание
ORG_BASIS=Устав
